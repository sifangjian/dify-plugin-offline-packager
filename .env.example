# Marketplace API
MARKETPLACE_API_URL=https://marketplace.dify.ai

# pip 下载镜像源
PIP_MIRROR_URL=https://mirrors.aliyun.com/pypi/simple

# GitHub API（预留）
GITHUB_API_URL=https://github.com

# 服务配置
HOST=0.0.0.0
PORT=8080

# 文件上传限制（MB）
MAX_UPLOAD_SIZE_MB=500

# 打包工作目录
WORK_DIR=/app/workspace

# 前端静态文件目录
STATIC_DIR=frontend/dist

# Dify Plugin CLI 工具路径（默认自动检测 app 目录下的二进制文件）
# DIFY_PLUGIN_CLI_LINUX_AMD64=/app/dify-plugin-linux-amd64
# DIFY_PLUGIN_CLI_LINUX_ARM64=/app/dify-plugin-linux-arm64
# DIFY_PLUGIN_CLI_DARWIN_AMD64=/app/dify-plugin-darwin-amd64
# DIFY_PLUGIN_CLI_DARWIN_ARM64=/app/dify-plugin-darwin-arm64
